# Hourly: the alert check and, once a day, the database copy (keep 14). No model calls.
[Unit]
Description=Embassy v2 maintenance (alerts, daily backup)

[Service]
Type=oneshot
User=embassy
Group=embassy
WorkingDirectory=/opt/embassy
Environment=DATA_DIR=/opt/embassy/data
EnvironmentFile=-/etc/embassy/embassy.env
UnsetEnvironment=LLM_API_KEY
ExecStart=/usr/bin/node cli/maintain.ts --backup
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/embassy/data
