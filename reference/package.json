{
  "name": "aiembassy",
  "version": "2.0.0-alpha.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antoniophd/aiembassy.git",
    "directory": "reference"
  },
  "private": true,
  "type": "module",
  "description": "AI Embassy, reference implementation: a mission of AI agents in diplomatic roles, built on the public UN Transcripts.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run check:size && npm run format:check",
    "check:size": "node tools/check-file-size.ts",
    "format": "prettier --write \"web/**/*.ts\" \"engine/**/*.ts\" \"cli/**/*.ts\" \"tools/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"web/**/*.ts\" \"engine/**/*.ts\" \"cli/**/*.ts\" \"tools/**/*.ts\" \"tests/**/*.ts\"",
    "demo": "node cli/demo.ts",
    "meetings": "node cli/meetings-week.ts",
    "ingest": "node cli/ingest.ts",
    "status": "node cli/status.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
