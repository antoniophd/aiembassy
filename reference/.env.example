# Environment of the reference implementation. Names only: keep real values in your own
# environment file or secret store (readable only by the service user), never in git.

# Data directory (SQLite file, backups)
DATA_DIR=./data

# Web process (behind Caddy; loopback only)
HOST=127.0.0.1
PORT=3910

# Runs: three a day (UTC), with a budget per run
RUN_TIMES=06:00,14:00,22:00
RUN_MAX_MINUTES=120
RUN_MAX_CALLS=400

# Provider: ollama or openai-compatible, with its base URL and key.
LLM_PROVIDER=ollama
LLM_BASE_URL=https://ollama.com
LLM_API_KEY=

# Models. None is built in: name each one (guide, chapter 3). The checker must be of another
# model family than the writer, and the fallback's checker of another family than the fallback.
# Optional writer per role: LLM_MODEL_<ROLE>, for example LLM_MODEL_PR.
LLM_MODEL=
LLM_MODEL_CHECK=
LLM_MODEL_FALLBACK=
LLM_MODEL_CHECK_FALLBACK=
